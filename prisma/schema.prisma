generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceType {
  PERSONAL
  COACH
  COMMUNITY
  BUSINESS
}

enum WorkspaceRole {
  OWNER
  ADMIN
  COACH
  MEMBER
  VIEWER
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  passwordHash        String
  name                String
  role                UserRole            @default(USER)
  status              UserStatus          @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessions            Session[]
  modules             Module[]
  dailyPlans          DailyPlan[]
  ownedWorkspaces     Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers    WorkspaceMember[]
  programEnrollments  ProgramEnrollment[]
  progressSnapshots   ProgressSnapshot[]
  initiatedCoachLinks CoachClientLink[]   @relation("CoachLinkCoach")
  receivedCoachLinks  CoachClientLink[]   @relation("CoachLinkClient")
  coachInterventions  CoachIntervention[] @relation("CoachInterventionAuthor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Module {
  id                String              @id @default(cuid())
  ownerId           String
  workspaceId       String
  title             String
  subtitle          String?
  days              Int                 @default(40)
  activities        String[]
  startDate         DateTime?
  locksActivities   Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phases            Phase[]
  checks            Check[]
  notes             Note[]
  enrollments       ProgramEnrollment[]
  progressSnapshots ProgressSnapshot[]

  @@index([ownerId])
  @@index([workspaceId])
}

model Workspace {
  id                  String               @id @default(cuid())
  ownerId             String
  name                String
  type                WorkspaceType        @default(PERSONAL)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members             WorkspaceMember[]
  modules             Module[]
  dailyPlans          DailyPlan[]
  programEnrollments  ProgramEnrollment[]
  progressSnapshots   ProgressSnapshot[]
  subscriptions       Subscription[]
  billingTransactions BillingTransaction[]
  coachClientLinks    CoachClientLink[]
  coachInterventions  CoachIntervention[]

  @@index([ownerId, type])
}

enum CoachClientLinkStatus {
  PENDING
  ACTIVE
  DECLINED
  REVOKED
  EXPIRED
}

enum CoachInterventionType {
  PRIVATE_NOTE
  NUDGE
}

model CoachClientLink {
  id             String                @id @default(cuid())
  workspaceId    String
  coachUserId    String
  clientUserId   String?
  clientEmail    String
  status         CoachClientLinkStatus @default(PENDING)
  tokenHash      String                @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  consentedAt    DateTime?
  consentVersion String?
  declinedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coach          User                  @relation("CoachLinkCoach", fields: [coachUserId], references: [id], onDelete: Cascade)
  client         User?                 @relation("CoachLinkClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  interventions  CoachIntervention[]

  @@index([workspaceId, status])
  @@index([coachUserId, status])
  @@index([clientUserId, status])
  @@index([clientEmail, status])
  @@index([expiresAt])
}

model CoachIntervention {
  id                String                @id @default(cuid())
  workspaceId       String
  coachClientLinkId String
  authorUserId      String
  type              CoachInterventionType
  content           String
  createdAt         DateTime              @default(now())
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coachClientLink   CoachClientLink       @relation(fields: [coachClientLinkId], references: [id], onDelete: Cascade)
  author            User                  @relation("CoachInterventionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([coachClientLinkId, createdAt])
  @@index([authorUserId, createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
  @@index([workspaceId, role])
}

enum ProgramEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  CANCELED
  EXPIRED
}

enum BillingTransactionStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
}

model ProgramEnrollment {
  id          String                  @id @default(cuid())
  workspaceId String
  moduleId    String
  userId      String
  status      ProgramEnrollmentStatus @default(ACTIVE)
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module      Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([moduleId, status])
}

model ProgressSnapshot {
  id              String    @id @default(cuid())
  workspaceId     String
  moduleId        String
  userId          String
  date            DateTime  @db.Date
  day             Int?
  totalActivities Int
  checkedCount    Int
  totalCount      Int
  progress        Int
  perfectDays     Int
  currentStreak   Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module          Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId, date])
  @@index([workspaceId, date])
  @@index([userId, date])
  @@index([moduleId, date])
}

model Plan {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  monthlyPriceCents   Int
  yearlyPriceCents    Int
  currency            String               @default("IDR")
  entitlementConfig   Json
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subscriptions       Subscription[]
  billingTransactions BillingTransaction[]
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([planId])
  @@index([provider, providerSubscriptionId])
}

model BillingTransaction {
  id                String                   @id @default(cuid())
  workspaceId       String
  planId            String
  status            BillingTransactionStatus @default(PENDING)
  amountCents       Int
  currency          String                   @default("IDR")
  provider          String
  providerReference String?
  checkoutUrl       String?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan              Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([provider, providerReference])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  processedAt     DateTime?
  payload         Json?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, processedAt])
}

model Phase {
  id            String @id @default(cuid())
  moduleId      String
  label         String
  startDay      Int
  endDay        Int
  description   String
  position      Int
  targetPercent Int    @default(70)
  module        Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, position])
}

model Check {
  id          String   @id @default(cuid())
  moduleId    String
  day         Int
  activityIdx Int
  checkedAt   DateTime @default(now())
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, day, activityIdx])
}

model Note {
  id        String   @id @default(cuid())
  moduleId  String
  phaseKey  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, phaseKey])
}

model FeatureSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DailyPlan {
  id          String      @id @default(cuid())
  userId      String
  workspaceId String
  date        DateTime    @db.Date
  locked      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks      TimeBlock[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([workspaceId, date])
}

enum TimeBlockStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
}

model TimeBlock {
  id                   String          @id @default(cuid())
  planId               String
  label                String
  startMinute          Int
  endMinute            Int
  status               TimeBlockStatus @default(SCHEDULED)
  completedAt          DateTime?
  rescheduledAt        DateTime?
  rescheduledToBlockId String?
  rescheduleReason     String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  plan                 DailyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}
