DATABASE_URL="postgresql://tracker:tracker_local_password@localhost:5433/tracker_local?schema=public"
APP_URL="http://localhost:3500"
SESSION_COOKIE_NAME="tracker_session"
ADMIN_EMAIL="admin@local.test"
# ADMIN_PASSWORD is injected only during seed. Never commit it.

# Payment provider selection. Defaults to "mock" (no real API calls) when unset.
# Set to "sumopod" to activate the real Sumopod adapter — see src/lib/payment/sumopodProvider.ts
PAYMENT_PROVIDER="mock"
SUMOPOD_API_KEY=""
SUMOPOD_API_BASE_URL="https://api-pay-sandbox.sumopod.com"
# Comma-separated allowlist. Use only exact codes enabled in Sumopod payment dashboard.
SUMOPOD_PAYMENT_METHOD_TYPE_CODES="QRIS"
# From Sumopod dashboard Settings tab, format "whsec_...". Required for webhook signature
# verification — without it, verifyWebhookSignature always returns false.
SUMOPOD_WEBHOOK_SECRET=""
