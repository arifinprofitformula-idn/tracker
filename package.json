{
  "name": "tracker-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p 3500",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "db:local:init": "powershell -ExecutionPolicy Bypass -File scripts/local-db.ps1 init",
    "db:local:up": "powershell -ExecutionPolicy Bypass -File scripts/local-db.ps1 start",
    "db:local:down": "powershell -ExecutionPolicy Bypass -File scripts/local-db.ps1 stop",
    "db:local:status": "powershell -ExecutionPolicy Bypass -File scripts/local-db.ps1 status",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "db:backfill:workspaces": "tsx scripts/backfill-workspaces.ts",
    "db:backfill:program-enrollments": "tsx scripts/backfill-program-enrollments.ts",
    "db:backfill:progress-snapshots": "tsx scripts/backfill-progress-snapshots.ts",
    "seed:plans": "tsx scripts/seed-plans.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "simulate:webhook": "tsx scripts/simulate-webhook.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "prisma": "^6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
